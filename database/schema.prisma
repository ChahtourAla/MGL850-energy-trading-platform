
generator client {
  provider            = "prisma-client"
  output              = "../apps/backend/src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------
// 1. USERS
// -----------------------------------------------------

model User {
  id                  String   @id @default(uuid()) @db.Uuid
  name                String   @db.VarChar(255)
  email               String   @unique @db.VarChar(320)
  passwordHash        String   @map("password_hash") @db.Text
  accountOrigin       String   @default("REGISTERED") @map("account_origin") @db.VarChar(16)
  physicalAddress     String?  @map("physical_address") @db.Text
  xKm                 Decimal? @map("x_km") @db.Decimal(18, 8)
  yKm                 Decimal? @map("y_km") @db.Decimal(18, 8)
  preferredEnergyType String?  @map("preferred_energy_type") @db.VarChar(16)
  reputation          Int      @default(50) @db.SmallInt

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  wallet        Wallet?
  walletProvisioning WalletProvisioning?
  energyRecords EnergyRecord[]

  buyerMatches  Match[] @relation("MatchBuyer")
  sellerMatches Match[] @relation("MatchSeller")

  buyerTrades  Trade[] @relation("TradeBuyer")
  sellerTrades Trade[] @relation("TradeSeller")

  @@map("users")
}

// -----------------------------------------------------
// 2. WALLETS
// -----------------------------------------------------

model Wallet {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @unique @map("user_id") @db.Uuid
  hederaAccountId     String   @unique @map("hedera_account_id") @db.VarChar(64)
  evmAddress          String   @unique @map("evm_address") @db.VarChar(42)
  publicKey           String   @map("public_key") @db.Text
  encryptedPrivateKey String   @map("encrypted_private_key") @db.Text
  encryptionIv        String   @map("encryption_iv") @db.Text
  encryptionAuthTag   String   @map("encryption_auth_tag") @db.Text
  keyVersion          Int      @default(1) @map("key_version")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("wallets")
}

// -----------------------------------------------------
// 3. HOURLY ENERGY RECORDS
// -----------------------------------------------------

model EnergyRecord {
  id                          String   @id @default(uuid()) @db.Uuid
  userId                      String   @map("user_id") @db.Uuid
  timeSlot                    DateTime @map("time_slot") @db.Timestamptz(3)
  productionWh                BigInt   @map("production_wh")
  consumptionWh               BigInt   @map("consumption_wh")
  netEnergyWh                 BigInt   @map("net_energy_wh")
  marketRole                  String   @map("market_role") @db.VarChar(16)
  availableEnergyWh           BigInt?  @map("available_energy_wh")
  requiredEnergyWh            BigInt?  @map("required_energy_wh")
  energyType                  String?  @map("energy_type") @db.VarChar(16)
  askPriceMicrousdPerKwh      BigInt?  @map("ask_price_microusd_per_kwh")
  maxPriceMicrousdPerKwh      BigInt?  @map("max_price_microusd_per_kwh")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, timeSlot])
  @@index([timeSlot, marketRole])
  @@map("energy_records")
}

// -----------------------------------------------------
// 4. MATCHES
// -----------------------------------------------------

model Match {
  // Supplied by the Python matching engine as matchId.
  id                         String   @id @db.Uuid
  timeSlot                   DateTime @map("time_slot") @db.Timestamptz(3)
  buyerId                    String   @map("buyer_id") @db.Uuid
  sellerId                   String   @map("seller_id") @db.Uuid
  quantityWh                 BigInt   @map("quantity_wh")
  unitPriceMicrousdPerKwh    BigInt   @map("unit_price_microusd_per_kwh")
  totalAmountMicrousd        BigInt   @map("total_amount_microusd")
  distanceKm                 Decimal  @map("distance_km") @db.Decimal(20, 12)
  score                      Decimal  @db.Decimal(20, 12)
  sellerEnergyType           String   @map("seller_energy_type") @db.VarChar(16)
  algorithmVersion           String   @map("algorithm_version") @db.VarChar(64)
  status                     String   @default("SELECTED") @db.VarChar(24)
  createdAt                  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  buyer User @relation("MatchBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  seller User @relation("MatchSeller", fields: [sellerId], references: [id], onDelete: Restrict)

  trade Trade?

  @@index([timeSlot])
  @@index([buyerId, timeSlot])
  @@index([sellerId, timeSlot])
  @@map("matches")
}

// -----------------------------------------------------
// 5. TRADES
// -----------------------------------------------------

model Trade {
  id                       String   @id @default(uuid()) @db.Uuid
  matchId                  String   @unique @map("match_id") @db.Uuid
  externalTradeId          String   @unique @map("external_trade_id") @db.VarChar(66)
  onChainTradeId           BigInt?  @unique @map("on_chain_trade_id")

  buyerId                  String   @map("buyer_id") @db.Uuid
  sellerId                 String   @map("seller_id") @db.Uuid
  quantityWh               BigInt   @map("quantity_wh")
  unitPriceMicrousdPerKwh  BigInt   @map("unit_price_microusd_per_kwh")
  totalAmountMicrousd      BigInt   @map("total_amount_microusd")

  deliveryStart            DateTime @map("delivery_start") @db.Timestamptz(3)
  deliveryDeadline         DateTime @map("delivery_deadline") @db.Timestamptz(3)

  status                   String   @default("CREATED") @db.VarChar(32)
  contractAddress          String?  @map("contract_address") @db.VarChar(42)

  createTxId               String?  @map("create_tx_id") @db.VarChar(128)
  fundTxId                 String?  @map("fund_tx_id") @db.VarChar(128)
  confirmTxId              String?  @map("confirm_tx_id") @db.VarChar(128)
  settlementTxId           String?  @map("settlement_tx_id") @db.VarChar(128)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  match  Match @relation(fields: [matchId], references: [id], onDelete: Restrict)
  buyer User  @relation("TradeBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  seller User @relation("TradeSeller", fields: [sellerId], references: [id], onDelete: Restrict)

  deliveryRecords         DeliveryRecord[]
  blockchainTransactions  BlockchainTransaction[]

  @@index([buyerId, status])
  @@index([sellerId, status])
  @@index([status])
  @@map("trades")
}

// -----------------------------------------------------
// 6. DELIVERY RECORDS
// -----------------------------------------------------

model DeliveryRecord {
  id            String   @id @default(uuid()) @db.Uuid
  tradeId       String   @map("trade_id") @db.Uuid
  expectedWh    BigInt   @map("expected_wh")
  deliveredWh   BigInt   @map("delivered_wh")
  timeSlot      DateTime @map("time_slot") @db.Timestamptz(3)
  status        String   @default("PENDING") @db.VarChar(24)
  evidenceHash  String?  @map("evidence_hash") @db.VarChar(66)
  oracleTxId    String?  @map("oracle_tx_id") @db.VarChar(128)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Restrict)

  @@index([tradeId, timeSlot])
  @@map("delivery_records")
}

// -----------------------------------------------------
// 7. BLOCKCHAIN TRANSACTIONS
// -----------------------------------------------------

model BlockchainTransaction {
  id                  String    @id @default(uuid()) @db.Uuid
  tradeId             String?   @map("trade_id") @db.Uuid
  operation           String    @db.VarChar(64)
  hederaTransactionId String?   @map("hedera_transaction_id") @db.VarChar(128)
  transactionHash     String?   @map("transaction_hash") @db.VarChar(128)
  status              String    @db.VarChar(32)
  networkFeeTinybar   BigInt?   @map("network_fee_tinybar")
  errorCode           String?   @map("error_code") @db.VarChar(128)
  errorMessage        String?   @map("error_message") @db.Text
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  confirmedAt         DateTime? @map("confirmed_at") @db.Timestamptz(3)

  trade Trade? @relation(fields: [tradeId], references: [id], onDelete: Restrict)

  @@index([hederaTransactionId])
  @@index([tradeId, createdAt])
  @@map("blockchain_transactions")
}


model WalletProvisioning {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @unique @map("user_id") @db.Uuid
  publicKey           String   @map("public_key") @db.Text
  evmAddress          String   @unique @map("evm_address") @db.VarChar(42)
  encryptedPrivateKey String   @map("encrypted_private_key") @db.Text
  encryptionIv        String   @map("encryption_iv") @db.Text
  encryptionAuthTag   String   @map("encryption_auth_tag") @db.Text
  keyVersion          Int      @default(1) @map("key_version")
  transactionId       String   @unique @map("transaction_id") @db.VarChar(128)
  state               String   @default("PREPARED") @db.VarChar(32)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([state, createdAt])
  @@map("wallet_provisioning")
}