
generator client {
  provider            = "prisma-client"
  output              = "../apps/backend/src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------
// 1. USERS
// -----------------------------------------------------

model User {
  id                  String   @id @default(uuid()) @db.Uuid
  name                String   @db.VarChar(255)
  email               String   @unique @db.VarChar(320)
  passwordHash        String   @map("password_hash") @db.Text
  accountOrigin       String   @default("REGISTERED") @map("account_origin") @db.VarChar(16)
  physicalAddress     String?  @map("physical_address") @db.Text
  xKm                 Decimal? @map("x_km") @db.Decimal(18, 8)
  yKm                 Decimal? @map("y_km") @db.Decimal(18, 8)
  preferredEnergyType String?  @map("preferred_energy_type") @db.VarChar(16)
  reputation          Int      @default(50) @db.SmallInt

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  b24Policies B24SpendingPolicy[]
  v2Measurements V2SnapshotMeasurement[]
  v2Positions V2Position[]
  v2Purchases V2Allocation[] @relation("V2Buyer")
  v2Sales V2Allocation[] @relation("V2Seller")

  wallet        Wallet?
  walletProvisioning WalletProvisioning?
  energyRecords EnergyRecord[]

  buyerMatches  Match[] @relation("MatchBuyer")
  sellerMatches Match[] @relation("MatchSeller")

  buyerTrades  Trade[] @relation("TradeBuyer")
  sellerTrades Trade[] @relation("TradeSeller")

  @@map("users")
}

// -----------------------------------------------------
// 2. WALLETS
// -----------------------------------------------------

model Wallet {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @unique @map("user_id") @db.Uuid
  hederaAccountId     String   @unique @map("hedera_account_id") @db.VarChar(64)
  evmAddress          String   @unique @map("evm_address") @db.VarChar(42)
  publicKey           String   @map("public_key") @db.Text
  encryptedPrivateKey String   @map("encrypted_private_key") @db.Text
  encryptionIv        String   @map("encryption_iv") @db.Text
  encryptionAuthTag   String   @map("encryption_auth_tag") @db.Text
  keyVersion          Int      @default(1) @map("key_version")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("wallets")
}

// -----------------------------------------------------
// 3. HOURLY ENERGY RECORDS
// -----------------------------------------------------

model EnergyRecord {
  id                          String   @id @default(uuid()) @db.Uuid
  userId                      String   @map("user_id") @db.Uuid
  timeSlot                    DateTime @map("time_slot") @db.Timestamptz(3)
  productionWh                BigInt   @map("production_wh")
  consumptionWh               BigInt   @map("consumption_wh")
  netEnergyWh                 BigInt   @map("net_energy_wh")
  marketRole                  String   @map("market_role") @db.VarChar(16)
  availableEnergyWh           BigInt?  @map("available_energy_wh")
  requiredEnergyWh            BigInt?  @map("required_energy_wh")
  energyType                  String?  @map("energy_type") @db.VarChar(16)
  askPriceMicrousdPerKwh      BigInt?  @map("ask_price_microusd_per_kwh")
  maxPriceMicrousdPerKwh      BigInt?  @map("max_price_microusd_per_kwh")
  snapshotId                  String?  @map("snapshot_id") @db.Uuid
  snapshotImport              EnergySnapshotImport? @relation(fields: [snapshotId], references: [id], onDelete: Restrict)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, timeSlot])
  @@index([timeSlot, marketRole])
  @@map("energy_records")
  @@index([snapshotId])
}

// -----------------------------------------------------
// 4. MATCHES
// -----------------------------------------------------

model Match {
  b16OracleIntent B16OracleIntent?

  // Supplied by the Python matching engine as matchId.
  id                         String   @id @db.Uuid
  timeSlot                   DateTime @map("time_slot") @db.Timestamptz(3)
  buyerId                    String   @map("buyer_id") @db.Uuid
  sellerId                   String   @map("seller_id") @db.Uuid
  quantityWh                 BigInt   @map("quantity_wh")
  unitPriceMicrousdPerKwh    BigInt   @map("unit_price_microusd_per_kwh")
  totalAmountMicrousd        BigInt   @map("total_amount_microusd")
  distanceKm                 Decimal  @map("distance_km") @db.Decimal(20, 12)
  score                      Decimal  @db.Decimal(20, 12)
  sellerEnergyType           String   @map("seller_energy_type") @db.VarChar(16)
  algorithmVersion           String   @map("algorithm_version") @db.VarChar(64)
  status                     String   @default("SELECTED") @db.VarChar(24)
  createdAt                  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  b14TransactionIntents      B14TransactionIntent[]


  buyer User @relation("MatchBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  seller User @relation("MatchSeller", fields: [sellerId], references: [id], onDelete: Restrict)

  trade Trade?

  @@index([timeSlot])
  @@index([buyerId, timeSlot])
  @@index([sellerId, timeSlot])
  @@map("matches")
  b17OperatorIntents B17OperatorIntent[]
}

// -----------------------------------------------------
// 5. TRADES
// -----------------------------------------------------

model Trade {
  id                       String   @id @default(uuid()) @db.Uuid
  matchId                  String   @unique @map("match_id") @db.Uuid
  externalTradeId          String   @unique @map("external_trade_id") @db.VarChar(66)
  onChainTradeId           BigInt?  @unique @map("on_chain_trade_id")

  buyerId                  String   @map("buyer_id") @db.Uuid
  sellerId                 String   @map("seller_id") @db.Uuid
  quantityWh               BigInt   @map("quantity_wh")
  unitPriceMicrousdPerKwh  BigInt   @map("unit_price_microusd_per_kwh")
  totalAmountMicrousd      BigInt   @map("total_amount_microusd")

  deliveryStart            DateTime @map("delivery_start") @db.Timestamptz(3)
  deliveryDeadline         DateTime @map("delivery_deadline") @db.Timestamptz(3)

  status                   String   @default("CREATED") @db.VarChar(32)
  contractAddress          String?  @map("contract_address") @db.VarChar(42)

  createTxId               String?  @map("create_tx_id") @db.VarChar(128)
  fundTxId                 String?  @map("fund_tx_id") @db.VarChar(128)
  confirmTxId              String?  @map("confirm_tx_id") @db.VarChar(128)
  settlementTxId           String?  @map("settlement_tx_id") @db.VarChar(128)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  match  Match @relation(fields: [matchId], references: [id], onDelete: Restrict)
  buyer User  @relation("TradeBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  seller User @relation("TradeSeller", fields: [sellerId], references: [id], onDelete: Restrict)

  deliveryRecords         DeliveryRecord[]
  blockchainTransactions  BlockchainTransaction[]

  @@index([buyerId, status])
  @@index([sellerId, status])
  @@index([status])
  @@map("trades")
}

// -----------------------------------------------------
// 6. DELIVERY RECORDS
// -----------------------------------------------------

model DeliveryRecord {
  id            String   @id @default(uuid()) @db.Uuid
  tradeId       String   @map("trade_id") @db.Uuid
  expectedWh    BigInt   @map("expected_wh")
  deliveredWh   BigInt   @map("delivered_wh")
  timeSlot      DateTime @map("time_slot") @db.Timestamptz(3)
  status        String   @default("PENDING") @db.VarChar(24)
  evidenceHash  String?  @map("evidence_hash") @db.VarChar(66)
  oracleTxId    String?  @map("oracle_tx_id") @db.VarChar(128)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Restrict)

  @@index([tradeId, timeSlot])
  @@map("delivery_records")
}

// -----------------------------------------------------
// 7. BLOCKCHAIN TRANSACTIONS
// -----------------------------------------------------

model BlockchainTransaction {
  id                  String    @id @default(uuid()) @db.Uuid
  tradeId             String?   @map("trade_id") @db.Uuid
  operation           String    @db.VarChar(64)
  hederaTransactionId String?   @map("hedera_transaction_id") @db.VarChar(128)
  transactionHash     String?   @map("transaction_hash") @db.VarChar(128)
  status              String    @db.VarChar(32)
  networkFeeTinybar   BigInt?   @map("network_fee_tinybar")
  errorCode           String?   @map("error_code") @db.VarChar(128)
  errorMessage        String?   @map("error_message") @db.Text
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  confirmedAt         DateTime? @map("confirmed_at") @db.Timestamptz(3)

  trade Trade? @relation(fields: [tradeId], references: [id], onDelete: Restrict)

  @@index([hederaTransactionId])
  @@index([tradeId, createdAt])
  @@map("blockchain_transactions")
}


model WalletProvisioning {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @unique @map("user_id") @db.Uuid
  publicKey           String   @map("public_key") @db.Text
  evmAddress          String   @unique @map("evm_address") @db.VarChar(42)
  encryptedPrivateKey String   @map("encrypted_private_key") @db.Text
  encryptionIv        String   @map("encryption_iv") @db.Text
  encryptionAuthTag   String   @map("encryption_auth_tag") @db.Text
  keyVersion          Int      @default(1) @map("key_version")
  transactionId       String   @unique @map("transaction_id") @db.VarChar(128)
  state               String   @default("PREPARED") @db.VarChar(32)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([state, createdAt])
  @@map("wallet_provisioning")
}


model EnergySnapshotImport {
  id               String   @id @db.Uuid
  timeSlot         DateTime @unique @map("time_slot") @db.Timestamptz(3)
  schemaVersion    String   @map("schema_version") @db.VarChar(32)
  generatorVersion String   @map("generator_version") @db.VarChar(32)
  payloadSha256    String   @map("payload_sha256") @db.Char(64)
  recordCount      Int      @map("record_count")
  importedAt       DateTime @default(now()) @map("imported_at") @db.Timestamptz(3)

  records EnergyRecord[]

  @@map("energy_snapshot_imports")
}


model MatchingRun {
  id                  String   @id @db.Uuid
  snapshotId          String   @map("snapshot_id") @db.Uuid
  timeSlot            DateTime @unique @map("time_slot") @db.Timestamptz(3)
  algorithmVersion    String   @map("algorithm_version") @db.VarChar(32)
  configSha256        String   @map("config_sha256") @db.Char(64)
  resultSha256        String   @map("result_sha256") @db.Char(64)
  matchCount          Int      @map("match_count")
  unmatchedBuyerCount Int      @map("unmatched_buyer_count")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([snapshotId])
  @@map("matching_runs")
}

model B14TransactionIntent {
  id                 String    @id @default(uuid()) @db.Uuid
  matchId            String    @map("match_id") @db.Uuid
  match              Match     @relation(fields: [matchId], references: [id], onDelete: Restrict)
  externalTradeId    String    @map("external_trade_id") @db.Char(66)
  operation          String    @db.VarChar(24)
  chainId            Int       @map("chain_id")
  signerAddress      String    @map("signer_address") @db.VarChar(42)
  targetAddress      String    @map("target_address") @db.VarChar(42)
  payloadSha256      String    @map("payload_sha256") @db.Char(64)
  status             String    @default("PLANNED") @db.VarChar(24)
  nonce              String?   @db.VarChar(78)
  txHash             String?   @unique @map("tx_hash") @db.VarChar(66)
  signedTxCiphertext String?   @map("signed_tx_ciphertext") @db.Text
  signedTxIv         String?   @map("signed_tx_iv") @db.VarChar(24)
  signedTxTag        String?   @map("signed_tx_tag") @db.VarChar(32)
  lastError          String?   @map("last_error") @db.Text
  confirmedAt        DateTime? @map("confirmed_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([matchId, operation])
  @@index([status])
  @@map("b14_transaction_intents")
}

// B16 oracle action is separate from B14 transaction intent journal.
model B16OracleIntent {
  id                 String    @id @default(uuid()) @db.Uuid
  matchId            String    @unique @map("match_id") @db.Uuid
  match              Match     @relation(fields: [matchId], references: [id], onDelete: Restrict)
  tradeId            String    @map("trade_id") @db.Uuid
  onChainTradeId     String    @map("on_chain_trade_id") @db.VarChar(78)
  deliveryId         String    @map("delivery_id") @db.Uuid
  evidencePayload    Json      @map("evidence_payload")
  evidenceHash       String    @map("evidence_hash") @db.Char(66)
  signerAddress      String    @map("signer_address") @db.VarChar(42)
  targetAddress      String    @map("target_address") @db.VarChar(42)
  callDataSha256     String    @map("call_data_sha256") @db.Char(64)
  status             String    @default("PLANNED") @db.VarChar(24)
  nonce              String?   @db.VarChar(78)
  txHash             String?   @unique @map("tx_hash") @db.VarChar(66)
  signedTxCiphertext String?   @map("signed_tx_ciphertext") @db.Text
  signedTxIv         String?   @map("signed_tx_iv") @db.VarChar(24)
  signedTxTag        String?   @map("signed_tx_tag") @db.VarChar(32)
  lastError          String?   @map("last_error") @db.Text
  confirmedAt        DateTime? @map("confirmed_at") @db.Timestamptz(3)
  syncedAt           DateTime? @map("synced_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status])
  @@map("b16_oracle_intents")
}

// B17 operator intent journal (distinct from B14 funding and B16 oracle journal).
model B17OperatorIntent {
  id                 String    @id @default(uuid()) @db.Uuid
  matchId            String    @map("match_id") @db.Uuid
  match              Match     @relation(fields: [matchId], references: [id], onDelete: Restrict)
  operation          String    @db.VarChar(12)
  externalTradeId    String    @map("external_trade_id") @db.Char(66)
  onChainTradeId     String    @map("on_chain_trade_id") @db.VarChar(78)
  chainId            Int       @default(296) @map("chain_id")
  signerAddress      String    @map("signer_address") @db.VarChar(42)
  targetAddress      String    @map("target_address") @db.VarChar(42)
  buyerAddress       String    @map("buyer_address") @db.VarChar(42)
  totalAmountMicrousd String   @map("total_amount_microusd") @db.VarChar(78)
  callDataSha256     String    @map("call_data_sha256") @db.Char(64)
  status             String    @default("PLANNED") @db.VarChar(24)
  nonce              String?   @db.VarChar(78)
  txHash             String?   @unique @map("tx_hash") @db.VarChar(66)
  signedTxCiphertext String?   @map("signed_tx_ciphertext") @db.Text
  signedTxIv         String?   @map("signed_tx_iv") @db.VarChar(24)
  signedTxTag        String?   @map("signed_tx_tag") @db.VarChar(32)
  lastError          String?   @map("last_error") @db.Text
  confirmedAt        DateTime? @map("confirmed_at") @db.Timestamptz(3)
  syncedAt           DateTime? @map("synced_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([matchId, operation])
  @@index([status])
  @@map("b17_operator_intents")
}


// B21: isolated historical market records; legacy escrow is unchanged.
model V2Market {
  id String @id @db.VarChar(66)
  namespace String @db.VarChar(80)
  mode String @db.VarChar(16)
  intervalStart DateTime @db.Timestamptz(3)
  intervalEnd DateTime @db.Timestamptz(3)
  status String @default("DISCOVERED") @db.VarChar(32)
  schemaVersion String @db.VarChar(16)
  configVersion String @db.VarChar(128)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  snapshots V2Snapshot[]
  plans V2AllocationPlan[]
  positions V2Position[]
  allocations V2Allocation[]
  b22Ingestions B22Ingestion[]
  @@unique([namespace, intervalStart, intervalEnd])
  @@index([status, intervalEnd])
}

model V2Snapshot {
  id String @id @db.Uuid
  marketId String @db.VarChar(66)
  intervalStart DateTime @db.Timestamptz(3)
  intervalEnd DateTime @db.Timestamptz(3)
  sourceIdentity String @db.VarChar(128)
  sourceVersion String @db.VarChar(128)
  configHash String @db.VarChar(66)
  payloadHash String @db.VarChar(66)
  schemaVersion String @db.VarChar(16)
  expectedCount Int
  actualCount Int
  completeness Json
  collectedAt DateTime @db.Timestamptz(3)
  finalizedAt DateTime? @db.Timestamptz(3)
  finalizer String? @db.VarChar(128)
  status String @default("PENDING") @db.VarChar(24)
  supersedesId String? @db.Uuid
  market V2Market @relation(fields: [marketId], references: [id], onDelete: Restrict)
  supersedes V2Snapshot? @relation("V2Correction", fields: [supersedesId], references: [id], onDelete: Restrict)
  corrections V2Snapshot[] @relation("V2Correction")
  measurements V2SnapshotMeasurement[]
  plans V2AllocationPlan[]
  allocations V2Allocation[]
  b22Ingestion B22Ingestion?
  @@unique([id, marketId])
  @@index([marketId, status])
}

model V2Position {
  marketId String @db.VarChar(66)
  userId String @db.Uuid
  productionWh BigInt
  consumptionWh BigInt
  netEnergyWh BigInt
  role String @db.VarChar(16)
  availableWh BigInt
  requiredWh BigInt
  matchedBoughtWh BigInt
  matchedSoldWh BigInt
  unmatchedDeficitWh BigInt
  unmatchedSurplusWh BigInt
  market V2Market @relation(fields: [marketId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@id([marketId, userId])
}

model V2Allocation {
  id String @id @db.VarChar(66)
  marketId String @db.VarChar(66)
  snapshotId String @db.Uuid
  planId String @db.VarChar(66)
  buyerId String @db.Uuid
  sellerId String @db.Uuid
  buyerAddress String @db.VarChar(42)
  sellerAddress String @db.VarChar(42)
  quantityWh BigInt
  unitPriceMicrousdPerKwh BigInt
  amountBaseUnits BigInt
  remainder Int
  algorithmVersion String @db.VarChar(128)
  pricingVersion String @db.VarChar(128)
  planVersion String @db.VarChar(128)
  status String @default("PLANNED") @db.VarChar(24)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  market V2Market @relation(fields: [marketId], references: [id], onDelete: Restrict)
  snapshot V2Snapshot @relation(fields: [snapshotId, marketId], references: [id, marketId], onDelete: Restrict)
  plan V2AllocationPlan @relation(fields: [planId, marketId, snapshotId], references: [id, marketId, snapshotId], onDelete: Restrict)
  buyer User @relation("V2Buyer", fields: [buyerId], references: [id], onDelete: Restrict)
  seller User @relation("V2Seller", fields: [sellerId], references: [id], onDelete: Restrict)
  b24Reservation B24AuthorizationReservation?
  intent V2SettlementIntent?
  @@unique([id, marketId])
  @@unique([marketId, snapshotId, buyerId, sellerId, buyerAddress, sellerAddress, quantityWh, unitPriceMicrousdPerKwh, algorithmVersion, pricingVersion, planVersion], map: "V2Allocation_logical_key")
  @@index([marketId, buyerId])
  @@index([marketId, sellerId])
}

model V2SettlementIntent {
  id String @id @db.VarChar(66)
  allocationId String @unique @db.VarChar(66)
  marketId String @db.VarChar(66)
  chainId Int
  tokenAddress String @db.VarChar(42)
  contractAddress String? @db.VarChar(42)
  amountBaseUnits BigInt
  status String @default("PLANNED") @db.VarChar(24)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  allocation V2Allocation @relation(fields: [allocationId, marketId], references: [id, marketId], onDelete: Restrict)
  attempts V2SettlementAttempt[]
  evidence V2SettlementEvidence[]
  @@unique([allocationId, marketId])
  @@index([status, updatedAt])
}

model V2SettlementAttempt {
  id String @id @db.Uuid
  settlementId String @db.VarChar(66)
  sequence Int
  status String @db.VarChar(24)
  txHash String? @db.VarChar(66)
  transactionIdentity String? @db.VarChar(128)
  nonce BigInt?
  errorCode String? @db.VarChar(128)
  recoveryMetadata Json?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  settlement V2SettlementIntent @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  @@unique([settlementId, sequence])
  @@index([txHash])
  @@index([transactionIdentity])
}

model V2SettlementEvidence {
  id String @id @db.Uuid
  settlementId String @db.VarChar(66)
  chainId Int
  contractAddress String @db.VarChar(42)
  tokenAddress String @db.VarChar(42)
  txHash String @db.VarChar(66)
  blockReference String? @db.VarChar(128)
  receiptStatus String @db.VarChar(16)
  logIndex Int
  buyerAddress String @db.VarChar(42)
  sellerAddress String @db.VarChar(42)
  amountBaseUnits BigInt
  confirmedAt DateTime @db.Timestamptz(3)
  verificationStatus String @db.VarChar(24)
  settlement V2SettlementIntent @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  @@unique([chainId, txHash, logIndex])
  @@index([settlementId, verificationStatus])
}


// Snapshot-scoped readings are facts; V2Position is a mutable market projection.
model V2SnapshotMeasurement {
  snapshotId String @db.Uuid
  marketId String @db.VarChar(66)
  userId String @db.Uuid
  productionWh BigInt
  consumptionWh BigInt
  snapshot V2Snapshot @relation(fields: [snapshotId, marketId], references: [id, marketId], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@id([snapshotId, userId])
  @@index([marketId, userId])
}

// A market may have alternative drafts, but only one irrevocable payable plan.
model V2AllocationPlan {
  id String @id @db.VarChar(66)
  marketId String @db.VarChar(66)
  snapshotId String @db.Uuid
  planVersion String @db.VarChar(128)
  manifestHash String @db.VarChar(66)
  manifest Json
  status String @default("DRAFT") @db.VarChar(24)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  market V2Market @relation(fields: [marketId], references: [id], onDelete: Restrict)
  snapshot V2Snapshot @relation(fields: [snapshotId, marketId], references: [id, marketId], onDelete: Restrict)
  allocations V2Allocation[]
  @@unique([id, marketId, snapshotId])
  @@unique([marketId, planVersion])
  @@index([marketId, status])
}

// B22-A: administrator-approved, immutable hourly participant roster.
model B22HourlyRegistry {
  id String @id @db.Uuid
  intervalStart DateTime @db.Timestamptz(3)
  intervalEnd DateTime @db.Timestamptz(3)
  revision Int
  profiles Json
  approvedBy String @db.VarChar(128)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  ingestions B22Ingestion[]
  @@unique([intervalStart, revision])
  @@index([intervalStart, intervalEnd])
}

// B22-A: trusted backend generator execution bound to its exact result.
model B22Ingestion {
  id String @id @db.Uuid
  marketId String @db.VarChar(66)
  snapshotId String @unique @db.Uuid
  registryId String @db.Uuid
  sourceIdentity String @db.VarChar(128)
  sourceVersion String @db.VarChar(128)
  principal String @db.VarChar(128)
  configHash String @db.VarChar(66)
  executableHash String @db.VarChar(66)
  payloadHash String @db.VarChar(66)
  contentDigest String @db.VarChar(66)
  payload Json
  result String @db.VarChar(24)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  market V2Market @relation(fields: [marketId], references: [id], onDelete: Restrict)
  snapshot V2Snapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  registry B22HourlyRegistry @relation(fields: [registryId], references: [id], onDelete: Restrict)
  @@index([marketId])
}

// B24-A1: offline fixture authority and durable reservations, distinct from payments.
model B24Deployment {
  id String @id @db.Uuid
  status String @db.VarChar(24)
  chainId Int
  contractAddress String @db.VarChar(42)
  tokenAddress String @db.VarChar(42)
  tokenDecimals Int
  codeHash String @db.VarChar(66)
  artifactHash String @db.VarChar(66)
  approvalPrincipal String @db.VarChar(128)
  approvalEvidence String @db.Text
  verifiedAt DateTime @db.Timestamptz(3)
  policies B24SpendingPolicy[]
  reservations B24AuthorizationReservation[]
  @@unique([chainId, contractAddress])
}
model B24SpendingPolicy {
  id String @id @db.Uuid
  buyerId String @db.Uuid
  buyerAddress String @db.VarChar(42)
  deploymentId String @db.Uuid
  tokenAddress String @db.VarChar(42)
  marketId String? @db.VarChar(66)
  perAllocationLimit BigInt
  cumulativeLimit BigInt
  effectiveAt DateTime @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  status String @db.VarChar(16)
  consentKind String @db.VarChar(32)
  version Int
  approver String @db.VarChar(128)
  auditReference String @db.Text
  buyer User @relation(fields:[buyerId], references:[id], onDelete: Restrict)
  deployment B24Deployment @relation(fields:[deploymentId], references:[id], onDelete: Restrict)
  reservations B24AuthorizationReservation[]
}
model B24AuthorizationReservation {
  id String @id @db.Uuid
  allocationId String @unique @db.VarChar(66)
  marketId String @db.VarChar(66)
  deploymentId String @db.Uuid
  policyId String @db.Uuid
  buyerAddress String @db.VarChar(42)
  amountBaseUnits BigInt
  nonce BigInt
  deadline DateTime @db.Timestamptz(3)
  planCommitment String @db.VarChar(66)
  settlementId String @db.VarChar(66)
  terms Json
  status String @default("RESERVED") @db.VarChar(24)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  allocation V2Allocation @relation(fields:[allocationId,marketId], references:[id,marketId], onDelete: Restrict)
  deployment B24Deployment @relation(fields:[deploymentId], references:[id], onDelete: Restrict)
  policy B24SpendingPolicy @relation(fields:[policyId], references:[id], onDelete: Restrict)
  @@unique([allocationId,marketId])
  @@unique([deploymentId,buyerAddress,nonce])
  @@index([policyId])
}
