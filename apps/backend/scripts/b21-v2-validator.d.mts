export type V2Kind = 'market' | 'snapshot' | 'position' | 'allocation' | 'intent' | 'attempt' | 'evidence' | 'snapshotPayload' | 'matchingManifest' | 'snapshotMeasurement' | 'allocationPlan';
export type DecimalInteger = string;
export type UtcTimestamp = string;
export type HexAddress = string;
export type HexHash = string;
export interface V2Market { schemaVersion:'2.0.0'; marketId:HexHash; namespace:string; mode:'HOURLY'|'SIMULATION'; intervalStart:UtcTimestamp; intervalEnd:UtcTimestamp; status:'DISCOVERED'|'WAITING_DATA'|'FINALIZED'|'MATCHED'|'SETTLING'|'COMPLETE'|'INVALID'|'QUARANTINED'|'PARTIAL'|'RECONCILIATION_REQUIRED'; configVersion:string; createdAt:UtcTimestamp; updatedAt:UtcTimestamp }
export interface V2Snapshot { schemaVersion:'2.0.0'; snapshotId:string; marketId:HexHash; intervalStart:UtcTimestamp; intervalEnd:UtcTimestamp; sourceIdentity:string; sourceVersion:string; configHash:HexHash; payloadHash:HexHash; expectedCount:number; actualCount:number; completeness:Record<string,unknown>; collectedAt:UtcTimestamp; status:'PENDING'|'INVALID'|'FINALIZED'; finalizedAt?:UtcTimestamp; finalizer?:string; supersedesId?:string }
export interface V2Position { userId:string; marketId:HexHash; productionWh:DecimalInteger; consumptionWh:DecimalInteger; netEnergyWh:DecimalInteger; role:'BUYER'|'SELLER'|'NEUTRAL'; availableWh:DecimalInteger; requiredWh:DecimalInteger; matchedBoughtWh:DecimalInteger; matchedSoldWh:DecimalInteger; unmatchedDeficitWh:DecimalInteger; unmatchedSurplusWh:DecimalInteger }
export interface V2Allocation { allocationId:HexHash; marketId:HexHash; snapshotId:string; planId:HexHash; buyerId:string; sellerId:string; buyerAddress:HexAddress; sellerAddress:HexAddress; quantityWh:DecimalInteger; unitPriceMicrousdPerKwh:DecimalInteger; amountBaseUnits:DecimalInteger; remainder:number; algorithmVersion:string; pricingVersion:string; planVersion:string; status:'PLANNED'|'VALIDATED'|'CANCELLED'; createdAt:UtcTimestamp }
export interface V2Intent { settlementId:HexHash; allocationId:HexHash; marketId:HexHash; chainId:296; tokenAddress:HexAddress; contractAddress?:HexAddress; amountBaseUnits:DecimalInteger; status:'PLANNED'|'READY'|'SIGNED'|'SUBMITTED'|'CONFIRMED'|'PROJECTED'|'BLOCKED'|'REVERTED'|'UNKNOWN'; createdAt:UtcTimestamp; updatedAt:UtcTimestamp }
export interface V2Attempt { attemptId:string; settlementId:HexHash; sequence:number; status:'PLANNED'|'SIGNED'|'SUBMITTED'|'CONFIRMED'|'REVERTED'|'UNKNOWN'|'NEEDS_RECONCILIATION'; txHash?:HexHash; transactionIdentity?:string; nonce?:DecimalInteger; errorCode?:string; recoveryMetadata?:Record<string,unknown>; createdAt:UtcTimestamp; updatedAt:UtcTimestamp }
export interface V2Evidence { evidenceId:string; settlementId:HexHash; chainId:296; contractAddress:HexAddress; tokenAddress:HexAddress; txHash:HexHash; blockReference?:string; receiptStatus:'SUCCESS'|'FAILED'; logIndex:number; buyerAddress:HexAddress; sellerAddress:HexAddress; amountBaseUnits:DecimalInteger; confirmedAt:UtcTimestamp; verificationStatus:'PENDING'|'VERIFIED'|'REJECTED' }
export interface V2SnapshotPayload { schemaVersion:'2.0.0'; marketId:HexHash; participants:Array<{userId:string;productionWh:DecimalInteger;consumptionWh:DecimalInteger}> }
export interface V2MatchingParticipant { userId:string; timeSlot:UtcTimestamp; productionWh:DecimalInteger; consumptionWh:DecimalInteger; marketRole:'BUYER'|'SELLER'|'NEUTRAL'; availableWh:DecimalInteger; requiredWh:DecimalInteger; energyType:'SOLAR'|'WIND'|'HYDRO'|'GRID'|'MIXED'|null; askPriceMicrousdPerKwh:DecimalInteger|null; maxPriceMicrousdPerKwh:DecimalInteger|null; xKm:string; yKm:string; reputation:DecimalInteger; preferredEnergyType:'ANY'|'SOLAR'|'WIND'|'HYDRO'|'GRID'|'MIXED'; evmAddress:HexAddress }
export interface V2MatchingManifest { schemaVersion:'1.0.0'; marketId:HexHash; snapshotHash:HexHash; intervalStart:UtcTimestamp; intervalEnd:UtcTimestamp; algorithmVersion:string; pricingPolicyVersion:string; maximumDistanceKm:string; scoringWeights:{quantity:string; price:string; distance:string; reputation:string}; participants:V2MatchingParticipant[] }
export interface V2SnapshotMeasurement { snapshotId:string; marketId:HexHash; userId:string; productionWh:DecimalInteger; consumptionWh:DecimalInteger }
export interface V2AllocationPlan { planId:HexHash; marketId:HexHash; snapshotId:string; planVersion:string; manifestHash:HexHash; manifest:V2MatchingManifest; status:'DRAFT'|'SUPERSEDED'|'AUTHORITATIVE'; createdAt:UtcTimestamp }
export interface V2Contracts { market:V2Market; snapshot:V2Snapshot; position:V2Position; allocation:V2Allocation; intent:V2Intent; attempt:V2Attempt; evidence:V2Evidence; snapshotPayload:V2SnapshotPayload; matchingManifest:V2MatchingManifest; snapshotMeasurement:V2SnapshotMeasurement; allocationPlan:V2AllocationPlan }
/** Does not verify blockchain evidence; cross-record checks require trusted context. */
export function validateV2<K extends V2Kind>(kind:K, value:unknown, context?:Record<string,unknown>):V2Contracts[K];
