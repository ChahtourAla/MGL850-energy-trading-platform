# Application
NODE_ENV=development

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=energy_trading
POSTGRES_USER=energy_admin
POSTGRES_PASSWORD=change_me

DATABASE_URL=postgresql://energy_admin:change_me@localhost:5432/energy_trading

# Backend
BACKEND_PORT=3001

# Frontend
FRONTEND_PORT=3000

# Hedera
HEDERA_NETWORK=testnet

# Never place real keys in this file
HEDERA_OPERATOR_ACCOUNT_ID=
HEDERA_OPERATOR_PRIVATE_KEY=

# Smart Contracts
ENERGY_TRADING_CONTRACT_ADDRESS=

# Authentication
JWT_SECRET=change_me
# JWT_ACCESS_SECRET=generate_a_unique_random_secret


HEDERA_NETWORK=testnet
# B13 read-only Hedera Testnet RPC
HEDERA_TESTNET_RPC_URL=https://testnet.hashio.io/api
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
WALLET_PROVISIONING_ENABLED=true
WALLET_ENCRYPTION_KEY_B64=

