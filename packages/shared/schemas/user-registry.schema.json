{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://energy-trading.example/schemas/user-registry.schema.json",
  "title": "Static User Registry",

  "type": "object",
  "additionalProperties": false,

  "required": ["schemaVersion", "users"],

  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/SchemaVersion"
    },

    "users": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "user.schema.json"
      }
    }
  }
}
