{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://energy-trading.example/schemas/common.schema.json",
  "title": "P2P Energy Trading — Shared Types",

  "$defs": {
    "UUID": {
      "type": "string",
      "format": "uuid"
    },

    "SchemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },

    "UTCDateTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },

    "HourTimeSlot": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T(?:[01]\\d|2[0-3]):00:00Z$"
    },

    "EvmAddress": {
      "type": "string",
      "pattern": "^0x[a-fA-F0-9]{40}$"
    },

    "HederaAccountId": {
      "type": "string",
      "pattern": "^0\\.0\\.[0-9]+$"
    },

    "EnergyType": {
      "type": "string",
      "enum": ["SOLAR", "WIND", "HYDRO", "GRID", "MIXED"]
    },

    "PreferredEnergyType": {
      "type": "string",
      "enum": ["SOLAR", "WIND", "HYDRO", "GRID", "MIXED", "ANY"]
    },

    "MarketRole": {
      "type": "string",
      "enum": ["SELLER", "BUYER", "NEUTRAL"]
    },

    "Reputation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },

    "EnergyWh": {
      "type": "integer",
      "minimum": 0
    },

    "UnitPriceMicrousdPerKwh": {
      "type": "integer",
      "minimum": 1
    }
  }
}
