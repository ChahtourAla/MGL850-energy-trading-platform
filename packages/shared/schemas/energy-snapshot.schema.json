{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://energy-trading.example/schemas/energy-snapshot.schema.json",
  "title": "Energy Snapshot",

  "type": "object",
  "additionalProperties": false,

  "required": ["schemaVersion", "snapshotId", "timeSlot", "generatorVersion", "users"],

  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/SchemaVersion"
    },

    "snapshotId": {
      "$ref": "common.schema.json#/$defs/UUID"
    },

    "timeSlot": {
      "$ref": "common.schema.json#/$defs/HourTimeSlot"
    },

    "generatorVersion": {
      "$ref": "common.schema.json#/$defs/SchemaVersion"
    },

    "users": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "hourly-energy-record.schema.json"
      }
    }
  }
}
